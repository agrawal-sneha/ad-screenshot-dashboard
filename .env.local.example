# Paste the entire JSON content of your Google service account key file as a single line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# The ID from your Google Drive folder URL:
# https://drive.google.com/drive/folders/THIS_PART_IS_THE_ID
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# The ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_sheet_id_here

# --- Brand detection backend ---
# Default: the GitHub Copilot SDK, which uses your local Copilot subscription.
# It needs no API key — just a signed-in Copilot CLI (`copilot` / `/login`).

# Force a specific Copilot vision model. Defaults to claude-haiku-4.5 (fastest
# accurate option). Must be vision-capable or startup fails with the valid list.
# COPILOT_MODEL=claude-haiku-4.5
# Per-image timeout in ms. Default 90000.
# COPILOT_TIMEOUT_MS=90000

# Set to 1/true to use Gemini instead of Copilot (requires GEMINI_API_KEY below).
# USE_GEMINI=

# Set to 1/true to skip the model entirely and derive the brand from the filename.
# DEMO_MODE=

# Gemini API key — only needed when USE_GEMINI is enabled.
GEMINI_API_KEY=

# imgbb API key for image hosting (get from https://api.imgbb.com)
# If unset, images are saved to public/uploads and served locally.
IMGBB_API_KEY=

# --- Upload tuning ---
# Images processed in parallel per upload. Default 4.
# UPLOAD_CONCURRENCY=4
# Max images accepted in a single upload. Default 50.
# UPLOAD_MAX_FILES=50

# --- Optional: Gemini free-tier tuning (only used when USE_GEMINI=1) ---
# Override the Gemini model. Default gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash
# Min ms between Gemini calls; set 6000 to stay under ~10 req/min. 0 disables pacing. Default 0.
# GEMINI_MIN_INTERVAL_MS=0
# Retries on HTTP 429, honoring the API's suggested retry delay. Default 3.
# GEMINI_MAX_RETRIES=3
# Cap for a single backoff wait (ms) so requests stay within maxDuration. Default 15000.
# GEMINI_MAX_BACKOFF_MS=15000
